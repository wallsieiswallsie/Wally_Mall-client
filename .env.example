# Public build-time configuration; never put secrets in VITE_*.
# Live API is the default. Set true only to run the isolated browser prototype.
VITE_PROTOTYPE_MODE=false
# Server origin only. For local development, leave empty to use Vite's /api proxy.
# Production builds require https://your-api-domain.example (no /api/v1 or /v1).
VITE_API_URL=
# Vite dev/preview only. Not exposed to the browser; not used by static hosting.
API_PROXY_TARGET=http://127.0.0.1:3001

# Optional portal origins. Leave empty to preserve same-origin navigation.
# Set only after each corresponding frontend is deployed. No tokens are shared.
VITE_BUYER_URL=
VITE_SELLER_URL=
VITE_ADMIN_URL=
VITE_COURIER_URL=
