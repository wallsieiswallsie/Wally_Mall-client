# Public build-time configuration; never put secrets in VITE_*.
# Live API is the default. Set true only to run the isolated browser prototype.
VITE_PROTOTYPE_MODE=false
# Development: relative URL through Vite. Production: /api/v1 behind a reverse
# proxy, or https://your-api-domain.example/api/v1 (configure server CORS too).
VITE_API_BASE_URL=/api/v1
# Vite dev/preview only. Not exposed to the browser; not used by static hosting.
API_PROXY_TARGET=http://127.0.0.1:3001
